			"name": "Get User Progress",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Vérifie que le code HTTP est 200\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Vérifie que la réponse contient les champs attendus\r",
							"pm.test(\"Response contains progress info\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.property(\"points\");\r",
							"    pm.expect(jsonData).to.have.property(\"hoursSpent\");\r",
							"    pm.expect(jsonData).to.have.property(\"modulesCompleted\");\r",
							"    pm.expect(jsonData).to.have.property(\"badges\");\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
