		{
			"name": "POST Create Course",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Response has message property\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response).to.have.property(\"message\");\r",
							"});\r",
							"\r",
							"pm.test(\"Course was created with correct fields\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response.course).to.have.property(\"id\");\r",
							"    pm.expect(response.course).to.have.property(\"title\");\r",
							"    pm.expect(response.course).to.have.property(\"domain\");\r",
							"    pm.expect(response.course).to.have.property(\"level\");\r",
							"});\r",
							"\r",
							"pm.test(\"Course has default values\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response.course.enrolled).to.equal(0);\r",
							"    pm.expect(response.course.completionRate).to.equal(0);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
